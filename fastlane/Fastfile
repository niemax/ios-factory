require "json"
require "net/http"

default_platform(:ios)

# Plain App Store Connect API call (Spaceship has no Xcode Cloud support).
# Needs app_store_connect_api_key to have run first.
def asc_api(method, path, body = nil)
  uri = URI("https://api.appstoreconnect.apple.com#{path}")
  request = Net::HTTP.const_get(method.capitalize).new(uri)
  request["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  if body
    request["Content-Type"] = "application/json"
    request.body = body.to_json
  end
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
  json = response.body.to_s.empty? ? {} : JSON.parse(response.body)
  return nil if response.code == "404"
  unless response.code.start_with?("2")
    details = (json["errors"] || []).map { |e| e["detail"] }.join("; ")
    UI.user_error!("#{method} #{path} → #{response.code}: #{details}")
  end
  json
end

def asc_api_key!
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
  )
end

# App Store Connect tooling for any app — builds are Xcode Cloud's job, never
# this file's. Run from this repo's root: `fastlane ios <lane> key:value …`.
#
# API key (all lanes): ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the
# .p8). The key is only handed to fastlane's own signer, never printed.

platform :ios do
  desc <<~DESC
    Idempotent App Store Connect setup for one app. Safe to re-run.

      1. Bundle ID + app record: if the app doesn't exist, `produce` creates
         both. The App Store Connect API can't create apps, so that step logs
         in with your Apple ID (FASTLANE_USER, password + 2FA prompt) — run it
         yourself in a terminal. Skipped entirely when the app exists.
      2. Internal TestFlight group with access to all builds (reuses any
         existing internal all-builds group, whatever it's called).
      3. Testers, comma-separated (must already be users on the team).

    Options: bundle_id:, name:, [sku:], [language:], [group:], [testers:], [dry_run:true]
  DESC
  lane :setup do |options|
    bundle_id = options.fetch(:bundle_id)
    name = options.fetch(:name)
    group_name = options[:group] || "Internal Testers"
    testers = options[:testers].to_s.split(",").map(&:strip).reject(&:empty?)
    dry_run = options[:dry_run].to_s == "true"

    asc_api_key!

    # 1. Bundle ID + app record
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    if app
      UI.success("App record exists (#{app.id}); bundle ID registered")
    elsif dry_run
      UI.important("Would create bundle ID #{bundle_id} + app record \"#{name}\" via produce (needs Apple ID login)")
      next
    else
      produce(
        app_identifier: bundle_id,
        app_name: name,
        sku: options[:sku] || bundle_id,
        language: options[:language] || "en-US",
        platform: "ios"
      )
      app = Spaceship::ConnectAPI::App.find(bundle_id) || UI.user_error!("App still not found after produce")
    end

    # 2. Internal TestFlight group that gets every build
    groups = app.get_beta_groups
    groups.each do |g|
      UI.message("existing group \"#{g.name}\" (#{g.is_internal_group ? 'internal' : 'external'}#{g.has_access_to_all_builds ? ', all builds' : ''})")
    end
    group = groups.find { |g| g.name == group_name } ||
            groups.find { |g| g.is_internal_group && g.has_access_to_all_builds }
    if group
      UI.success("Using TestFlight group \"#{group.name}\"")
    elsif dry_run
      UI.important("Would create internal TestFlight group \"#{group_name}\" with access to all builds")
    else
      group = app.create_beta_group(group_name: group_name, is_internal_group: true, has_access_to_all_builds: true)
      UI.success("Created internal TestFlight group \"#{group_name}\"")
    end

    # 3. Testers
    testers.each do |email|
      if group && Spaceship::ConnectAPI::BetaTester.all(filter: { email: email, betaGroups: group.id }).any?
        UI.success("Tester #{email} already in group")
      elsif dry_run || group.nil?
        UI.important("Would add tester #{email}")
      else
        begin
          Spaceship::ConnectAPI.post_beta_tester_assignment(beta_group_ids: [group.id], attributes: { email: email })
          UI.success("Added tester #{email}")
        rescue => e
          UI.error("Tester #{email}: #{e.message} (internal testers must already be users on the team)")
        end
      end
    end
  end

  desc <<~DESC
    Idempotent Xcode Cloud workflows for one app. Safe to re-run.

      main       → archive, upload as INTERNAL_ONLY (internal TestFlight)
      production → archive, upload as APP_STORE_ELIGIBLE (App Store release)

    A branch that already has a workflow starting on it is left alone. Uses
    the "Latest Release" Xcode/macOS aliases. Prerequisite (no API for it):
    the app must already be connected to Xcode Cloud once in Xcode
    (Product → Xcode Cloud → Create Workflow, granting repo access).

    Options: bundle_id:, scheme:, container: (repo-relative .xcodeproj/.xcworkspace), [dry_run:true]
  DESC
  lane :xcode_cloud do |options|
    bundle_id = options.fetch(:bundle_id)
    scheme = options.fetch(:scheme)
    container = options.fetch(:container)
    dry_run = options[:dry_run].to_s == "true"

    asc_api_key!
    app = Spaceship::ConnectAPI::App.find(bundle_id) || UI.user_error!("No app record for #{bundle_id} — run the setup lane first")

    product = asc_api("GET", "/v1/apps/#{app.id}/ciProduct")&.dig("data")
    unless product
      UI.user_error!("#{bundle_id} isn't connected to Xcode Cloud yet. In Xcode: Product → Xcode Cloud → Create Workflow, grant repo access, then re-run.")
    end
    repository = asc_api("GET", "/v1/ciProducts/#{product['id']}/primaryRepositories")["data"].first ||
                 UI.user_error!("Xcode Cloud product has no repository")
    latest = lambda do |type|
      asc_api("GET", "/v1/#{type}?limit=200")["data"].find { |v| v.dig("attributes", "name") == "Latest Release" } ||
        UI.user_error!("No \"Latest Release\" entry in #{type}")
    end
    xcode_version = latest.call("ciXcodeVersions")
    macos_version = latest.call("ciMacOsVersions")

    workflows = asc_api("GET", "/v1/ciProducts/#{product['id']}/workflows?limit=200")["data"]
    workflows.each { |w| UI.message("existing workflow \"#{w.dig('attributes', 'name')}\"") }
    starts_on = lambda do |branch|
      workflows.find do |w|
        (w.dig("attributes", "branchStartCondition", "source", "patterns") || []).any? { |p| p["pattern"] == branch && !p["isPrefix"] }
      end
    end

    [
      { branch: "main", name: "TestFlight Internal", audience: "INTERNAL_ONLY" },
      { branch: "production", name: "Production", audience: "APP_STORE_ELIGIBLE" }
    ].each do |target|
      if (existing = starts_on.call(target[:branch]))
        UI.success("#{target[:branch]}: workflow \"#{existing.dig('attributes', 'name')}\" already starts on it")
        next
      end
      if dry_run
        UI.important("#{target[:branch]}: would create \"#{target[:name]}\" (archive → #{target[:audience]})")
        next
      end
      asc_api("POST", "/v1/ciWorkflows", { data: {
        type: "ciWorkflows",
        attributes: {
          name: target[:name],
          description: "Created by ios-factory",
          containerFilePath: container,
          isEnabled: true,
          clean: true,
          branchStartCondition: {
            source: { isAllMatch: false, patterns: [{ pattern: target[:branch], isPrefix: false }] },
            autoCancel: true
          },
          actions: [{
            name: "Archive - iOS",
            actionType: "ARCHIVE",
            scheme: scheme,
            platform: "IOS",
            buildDistributionAudience: target[:audience],
            isRequiredToPass: true
          }]
        },
        relationships: {
          product: { data: { type: "ciProducts", id: product["id"] } },
          repository: { data: { type: "scmRepositories", id: repository["id"] } },
          xcodeVersion: { data: { type: "ciXcodeVersions", id: xcode_version["id"] } },
          macOsVersion: { data: { type: "ciMacOsVersions", id: macos_version["id"] } }
        }
      } })
      UI.success("#{target[:branch]}: created \"#{target[:name]}\" (archive → #{target[:audience]})")
    end
  end
end
