default_platform(:ios)

platform :ios do
  desc <<~DESC
    Test, build, sign, and upload a release build to TestFlight.

    Parameterized by the calling app — no app-specific values live in this
    lane. See ios-factory/README.md and .github/workflows/ios-release.yml
    for how a consuming app repo invokes this.

    Required options:
      project_dir:       directory (relative to this lane's working
                          directory) containing the app's .xcodeproj —
                          generated by `xcodegen generate` first if that
                          directory has a project.yml
      scheme:             Xcode scheme to test/build
      bundle_id:          app's bundle identifier
      team_id:             Apple Developer Team ID
      marketing_version:  CFBundleShortVersionString, parsed from the
                          release tag by the caller
      build_number:       CFBundleVersion — the workflow run's monotonic
                          github.run_number, never derived from the tag

    Required environment (App Store Connect API key — never Fastlane
    match, never certs/profiles in git):
      ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT (raw .p8 contents)
  DESC
  lane :release do |options|
    # Resolve to absolute once, up front — different fastlane actions
    # (scan/gym vs. plain Dir/File calls) don't all re-resolve a relative
    # path against the same cwd, confirmed by a real run where the same
    # relative string worked for XcodeGen but not for scan's :project.
    project_dir = File.expand_path(options.fetch(:project_dir))
    scheme = options.fetch(:scheme)
    bundle_id = options.fetch(:bundle_id)
    team_id = options.fetch(:team_id)
    marketing_version = options.fetch(:marketing_version)
    build_number = options.fetch(:build_number)

    if File.exist?(File.join(project_dir, "project.yml"))
      UI.message("Detected project.yml in #{project_dir} — generating Xcode project via XcodeGen")
      Dir.chdir(project_dir) { sh("xcodegen", "generate") }
    end

    xcodeproj = Dir.glob(File.join(project_dir, "*.xcodeproj")).first
    UI.user_error!("No .xcodeproj found in #{project_dir} after XcodeGen check") unless xcodeproj

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: false,
      in_house: false
    )

    scan(
      project: xcodeproj,
      scheme: scheme,
      devices: ["iPhone 17"],
      clean: true
    )

    gym(
      project: xcodeproj,
      scheme: scheme,
      export_method: "app-store",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      },
      xcargs: "-allowProvisioningUpdates MARKETING_VERSION=#{marketing_version} CURRENT_PROJECT_VERSION=#{build_number}",
      output_directory: "./build"
    )

    pilot(
      api_key: api_key,
      app_identifier: bundle_id,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end
end
