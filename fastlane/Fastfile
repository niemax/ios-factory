require "json"
require "time"

default_platform(:ios)

# Xcode Cloud workflows that distribute to "TestFlight (Internal Testing Only)" upload builds App
# Store Connect refuses to attach to a version ("The specified pre-release build could not be
# added"). The same version often has both kinds, so skip internal-only ones. Spaceship's Build
# model doesn't map buildAudienceType, hence the raw request.
# Only builds uploaded after `after` count: on a resubmit the previous attempt's
# build is already processed, and must not be shipped instead of the new one.
def newest_app_store_build(app, version, after:)
  response = Spaceship::ConnectAPI.tunes_request_client.get("v1/builds", {
    "filter[app]" => app.id, "filter[preReleaseVersion.version]" => version, sort: "-uploadedDate", limit: 20
  })
  eligible = response.body["data"].find do |build|
    build.dig("attributes", "buildAudienceType") != "INTERNAL_ONLY" &&
      Time.parse(build.dig("attributes", "uploadedDate")) > after
  end
  eligible && Spaceship::ConnectAPI::Build.get(build_id: eligible["id"])
end

def asc_api_key!
  # Local runs pass a file path; CI passes the raw .p8 contents from a secret.
  # Locally, put them in fastlane/.env (gitignored; fastlane loads it itself).
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID].reject { |name| ENV[name] }
  missing << "ASC_KEY_PATH (or ASC_KEY_CONTENT)" unless ENV["ASC_KEY_PATH"] || ENV["ASC_KEY_CONTENT"]
  UI.user_error!("Missing #{missing.join(', ')}. Locally: copy fastlane/.env.example to fastlane/.env and fill it in.") unless missing.empty?
  key = ENV["ASC_KEY_PATH"] ? { key_filepath: File.expand_path(ENV["ASC_KEY_PATH"]) } : { key_content: ENV["ASC_KEY_CONTENT"] }
  app_store_connect_api_key(key_id: ENV["ASC_KEY_ID"], issuer_id: ENV["ASC_ISSUER_ID"], **key)
end

# App Store Connect tooling for any app — builds are Xcode Cloud's job, never
# this file's. Run from this repo's root: `fastlane ios <lane> key:value …`.
#
# API key (all lanes): ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH (path to the
# .p8). The key is only handed to fastlane's own signer, never printed.

platform :ios do
  desc <<~DESC
    Idempotent App Store Connect setup for one app. Safe to re-run.

      1. Bundle ID + app record: if the app doesn't exist, `produce` creates
         both. The App Store Connect API can't create apps, so that step logs
         in with your Apple ID (FASTLANE_USER, password + 2FA prompt) — run it
         yourself in a terminal. Skipped entirely when the app exists.
      2. Internal TestFlight group with access to all builds (reuses any
         existing internal all-builds group, whatever it's called).
      3. Testers, comma-separated (must already be users on the team).

    Options: bundle_id:, name:, [sku:], [language:], [group:], [testers:], [dry_run:true]
  DESC
  lane :setup do |options|
    bundle_id = options.fetch(:bundle_id)
    name = options.fetch(:name)
    group_name = options[:group] || "Internal Testers"
    testers = options[:testers].to_s.split(",").map(&:strip).reject(&:empty?)
    dry_run = options[:dry_run].to_s == "true"

    asc_api_key!

    # 1. Bundle ID + app record
    app = Spaceship::ConnectAPI::App.find(bundle_id)
    if app
      UI.success("App record exists (#{app.id}); bundle ID registered")
    elsif dry_run
      UI.important("Would create bundle ID #{bundle_id} + app record \"#{name}\" via produce (needs Apple ID login)")
      next
    else
      produce(
        app_identifier: bundle_id,
        app_name: name,
        sku: options[:sku] || bundle_id,
        language: options[:language] || "en-US",
        platform: "ios"
      )
      app = Spaceship::ConnectAPI::App.find(bundle_id) || UI.user_error!("App still not found after produce")
    end

    # 2. Internal TestFlight group that gets every build
    groups = app.get_beta_groups
    groups.each do |g|
      UI.message("existing group \"#{g.name}\" (#{g.is_internal_group ? 'internal' : 'external'}#{g.has_access_to_all_builds ? ', all builds' : ''})")
    end
    group = groups.find { |g| g.name == group_name } ||
            groups.find { |g| g.is_internal_group && g.has_access_to_all_builds }
    if group
      UI.success("Using TestFlight group \"#{group.name}\"")
    elsif dry_run
      UI.important("Would create internal TestFlight group \"#{group_name}\" with access to all builds")
    else
      group = app.create_beta_group(group_name: group_name, is_internal_group: true, has_access_to_all_builds: true)
      UI.success("Created internal TestFlight group \"#{group_name}\"")
    end

    # 3. Testers
    testers.each do |email|
      if group && Spaceship::ConnectAPI::BetaTester.all(filter: { email: email, betaGroups: group.id }).any?
        UI.success("Tester #{email} already in group")
      elsif dry_run || group.nil?
        UI.important("Would add tester #{email}")
      else
        begin
          Spaceship::ConnectAPI.post_beta_tester_assignment(beta_group_ids: [group.id], attributes: { email: email })
          UI.success("Added tester #{email}")
        rescue => e
          UI.error("Tester #{email}: #{e.message} (internal testers must already be users on the team)")
        end
      end
    end
  end


  desc <<~DESC
    Ship a staged release to the App Store. Runs after a merge to production
    (CI, Linux), or locally. Reads what /release-ios staged in the app repo:

      fastlane/release.json                       {"bundle_id","version","submit_for_review"}
      fastlane/metadata/<locale>/release_notes.txt
      fastlane/screenshots/<locale>/…             (optional)

    Waits for Xcode Cloud's build of that version to finish processing, then
    deliver creates/updates the App Store version, uploads notes (and
    screenshots if staged), attaches the build and submits if asked.

    Options: app_dir: (app repo root), [built_after: ISO time, default: app_dir HEAD's commit time],
             [timeout_minutes: 90], [dry_run:true]
  DESC
  lane :release do |options|
    app_dir = File.expand_path(options.fetch(:app_dir))
    dry_run = options[:dry_run].to_s == "true"
    release = JSON.parse(File.read(File.join(app_dir, "fastlane/release.json")))
    bundle_id = release.fetch("bundle_id")
    version = release.fetch("version")
    submit = release.fetch("submit_for_review", true)
    metadata_path = File.join(app_dir, "fastlane/metadata")
    screenshots_path = File.join(app_dir, "fastlane/screenshots")
    has_screenshots = Dir.exist?(screenshots_path) && !Dir.glob(File.join(screenshots_path, "*/*.{png,jpg,jpeg}")).empty?
    locales = Dir.glob(File.join(metadata_path, "*/release_notes.txt")).map { |f| File.basename(File.dirname(f)) }.sort
    UI.user_error!("No fastlane/metadata/<locale>/release_notes.txt staged") if locales.empty?
    UI.message("Release #{version} of #{bundle_id}: notes in #{locales.join(', ')}; screenshots: #{has_screenshots ? 'yes' : 'keep existing'}; submit for review: #{submit}")

    asc_api_key!
    app = Spaceship::ConnectAPI::App.find(bundle_id) || UI.user_error!("No app record for #{bundle_id}")

    # The merge to production triggers both this run and Xcode Cloud's build, so
    # the build to ship is uploaded after that commit.
    after = options[:built_after] ? Time.parse(options[:built_after]) : Time.parse(sh("git", "-C", app_dir, "log", "-1", "--format=%cI", log: false).strip)
    UI.message("Shipping the newest App Store build of #{version} uploaded after #{after.utc.iso8601}")

    # Wait for that build to finish processing.
    deadline = Time.now + options.fetch(:timeout_minutes, 90).to_i * 60
    build = nil
    loop do
      build = newest_app_store_build(app, version, after: after)
      break if build && build.processed?
      break if dry_run
      UI.user_error!("No processed build of #{version} within the timeout") if Time.now > deadline
      UI.message(build ? "Build #{build.version} still processing…" : "Waiting for Xcode Cloud to upload an App Store build of #{version}…")
      sleep(60)
    end
    if dry_run
      UI.important(build ? "Would ship build #{build.version} (#{build.processing_state})" : "No App Store build of #{version} uploaded after #{after.utc.iso8601} yet")
      next
    end
    UI.user_error!("Build #{build.version} is #{build.processing_state}") unless build.processing_state == "VALID"

    deliver(
      app_identifier: bundle_id,
      app_version: version,
      build_number: build.version,
      metadata_path: metadata_path,
      skip_screenshots: !has_screenshots,
      screenshots_path: has_screenshots ? screenshots_path : nil,
      overwrite_screenshots: has_screenshots,
      skip_binary_upload: true,
      submit_for_review: submit,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      submission_information: { add_id_info_uses_idfa: false }
    )
    UI.success(submit ? "#{version} (build #{build.version}) submitted for review" : "#{version} (build #{build.version}) staged in App Store Connect — submit when ready")
  end

  desc "Print the App Store listing's locales and current version state. Options: bundle_id:"
  lane :locales do |options|
    asc_api_key!
    app = Spaceship::ConnectAPI::App.find(options.fetch(:bundle_id)) || UI.user_error!("No app record")
    version = app.get_latest_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No App Store version yet") unless version
    locales = version.get_app_store_version_localizations.map(&:locale).sort
    UI.success("latest version #{version.version_string} (#{version.app_store_state})")
    UI.success("locales: #{locales.join(',')}")
  end

  desc "List the team's apps (name, bundle ID). Doubles as an API key check."
  lane :apps do
    asc_api_key!
    apps = Spaceship::ConnectAPI::App.all
    apps.each { |app| UI.message("#{app.name} — #{app.bundle_id}") }
    UI.success("API key works: #{apps.count} app(s)")
  end
end
